<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0
         https://maven.apache.org/xsd/maven-4.0.0.xsd">

  <modelVersion>4.0.0</modelVersion>

  <groupId>cz.martim12</groupId>
  <artifactId>noteindex</artifactId>
  <version>1.0-SNAPSHOT</version>
  <packaging>pom</packaging>
  <modules>
    <module>noteindex-core</module>
    <module>noteindex-importer</module>
    <module>noteindex-persistence</module>
    <module>noteindex-search</module>
    <module>noteindex-gui</module>
    <module>noteindex-application</module>
    <module>noteindex-cli</module>
  </modules>

  <properties>
    <maven.compiler.source>25</maven.compiler.source>
    <maven.compiler.target>25</maven.compiler.target>
    <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
  </properties>

  <build>
    <plugins>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-javadoc-plugin</artifactId>
        <version>3.11.2</version>

        <executions>
          <execution>
            <id>aggregate-javadoc</id>
            <goals>
              <goal>aggregate</goal>
            </goals>
          </execution>
        </executions>

        <configuration>
          <doclint>none</doclint>
          <overview>${maven.multiModuleProjectDirectory}/src/main/javadoc/overview.html</overview>
        </configuration>
      </plugin>
    </plugins>
  </build>

  <dependencyManagement>
    <dependencies>

      <!-- SQLite JDBC -->
      <dependency>
        <groupId>org.xerial</groupId>
        <artifactId>sqlite-jdbc</artifactId>
        <version>3.50.3.0</version>
      </dependency>

      <!-- Testing -->
      <dependency>
        <groupId>org.junit.jupiter</groupId>
        <artifactId>junit-jupiter</artifactId>
        <version>5.13.4</version>
      </dependency>

    </dependencies>
  </dependencyManagement>

</project>